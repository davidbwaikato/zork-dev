# Language pins follow the newer Musical Atrium toolchain.
ZORKS_NODE_VERSION="24.18.0"
ZORKS_PNPM_VERSION="11.25.0"
# Keep the two installations in different venvs. Windows exact uses the Python
# pin from the supplied original Zorks dev; the portable profile uses TMA's pin.
ZORKS_COMFYUI_PROFILE="${ZORKS_COMFYUI_PROFILE:-portable}"
if [[ "$ZORKS_COMFYUI_PROFILE" == windows-exact && "${VENV_DIR:-}" != python-for-stableaudio ]]; then
  ZORKS_PYTHON_VERSION="3.12.13"
  ZORKS_PYTHON_BUILD_RELEASE="20260807"
  case "${VENV_DIR:-}" in
    ''|python-for-zork|python-for-zork-win11-exact) ZORKS_PYTHON_VENV=python-for-zork-win11-exact ;;
    *) ZORKS_PYTHON_VENV="$VENV_DIR" ;;
  esac
else
  ZORKS_PYTHON_VERSION="3.12.14"
  ZORKS_PYTHON_BUILD_RELEASE="20260901"
  case "${VENV_DIR:-}" in
    ''|python-for-zork|python-for-zork-win11-exact) ZORKS_PYTHON_VENV=python-for-zork ;;
    *) ZORKS_PYTHON_VENV="$VENV_DIR" ;;
  esac
fi
export ZORKS_COMFYUI_PROFILE
ZORKS_ZILF_VERSION="1.9.0"
ZORKS_ZILF_RELEASE="1.9"
ZORKS_FROTZ_VERSION="2.55"
ZORKS_FROTZ_SHA256="a8c4c4d79a2aa9b39e0efbbd3e0803f1dc5ef36f75f2c2945e295d190575eb09"
ZORKS_COMFYUI_VERSION="0.22.0"
export ZORKS_NODE_VERSION ZORKS_PNPM_VERSION
export ZORKS_PYTHON_VERSION ZORKS_PYTHON_BUILD_RELEASE ZORKS_PYTHON_VENV
export ZORKS_ZILF_VERSION ZORKS_ZILF_RELEASE ZORKS_FROTZ_VERSION ZORKS_COMFYUI_VERSION
